<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center py-12 px-4">
  <div class="max-w-md w-full">
    <div class="bg-white rounded-lg shadow-lg p-8">
      <h2 class="text-3xl font-bold text-center text-gray-800 mb-8">ログイン</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="mb-6">
          <%= f.label :email, "メールアドレス", class: "block text-gray-700 font-semibold mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div class="mb-6">
          <%= f.label :password, "パスワード", class: "block text-gray-700 font-semibold mb-2" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="mb-6 flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
            <%= f.label :remember_me, "ログイン状態を保持する", class: "ml-2 text-gray-700" %>
          </div>
        <% end %>

        <div class="mb-6">
          <%= f.submit "ログイン", class: "w-full px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition cursor-pointer font-semibold" %>
        </div>
      <% end %>

      <div class="text-center space-y-2">
        <%= link_to "新規登録", new_registration_path(resource_name), class: "text-indigo-600 hover:text-indigo-800" %>
        <span class="text-gray-400 mx-2">|</span>
        <%= link_to "パスワードを忘れた方", new_password_path(resource_name), class: "text-indigo-600 hover:text-indigo-800" %>
      </div>
    </div>
  </div>
</div>
