<%# app/views/devise/passwords/new.html.erb %>

<div style="background-color: #F7FFFE; min-height: calc(100vh - 120px); display: flex; align-items: center; justify-content: center; padding: 40px 16px;">
  <div style="width: 100%; max-width: 440px;">

    <div style="text-align: center; margin-bottom: 28px;">
      <h1 style="font-size: 28px; font-weight: 800; font-family: 'Syne', sans-serif; background: linear-gradient(135deg, #0ABFA3, #00C8D7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0 0 6px;">ThinkStorm</h1>
      <p style="font-size: 13px; color: #4A6972; margin: 0;">AIと協働するブレインストーミング</p>
    </div>

    <div class="ts-section-card">
      <div style="text-align: center; margin-bottom: 24px;">
        <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #D6F5F0; border-radius: 14px; font-size: 22px; margin-bottom: 12px;">🔑</div>
        <h2 style="font-size: 20px; font-weight: 700; color: #0F2027; margin: 0 0 8px;">パスワードをお忘れですか？</h2>
        <p style="font-size: 13px; color: #4A6972; margin: 0; line-height: 1.6;">登録済みのメールアドレスを入力してください。<br>パスワードリセット用のリンクをお送りします。</p>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div style="margin-bottom: 20px;">
          <%= f.label :email, "メールアドレス",
                style: "display: block; font-size: 13px; font-weight: 700; color: #0F2027; margin-bottom: 6px;" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                style: "width: 100%; border: 1.5px solid #C8EFEB; border-radius: 10px; padding: 10px 14px; font-size: 14px; color: #0F2027; background: #FFFFFF; outline: none; font-family: inherit; box-sizing: border-box;",
                onfocus: "this.style.borderColor='#0ABFA3'",
                onblur: "this.style.borderColor='#C8EFEB'" %>
        </div>

        <%= f.submit "リセットメールを送信する",
              style: "width: 100%; padding: 12px; background: linear-gradient(135deg, #0ABFA3, #00C8D7); color: white; border: none; border-radius: 10px; font-size: 15px; font-weight: 700; cursor: pointer; font-family: inherit; box-sizing: border-box;" %>
      <% end %>

      <div style="text-align: center; margin-top: 20px; display: flex; justify-content: center; gap: 16px;">
        <%= link_to "ログイン", new_session_path(resource_name),
              style: "font-size: 13px; color: #0ABFA3; font-weight: 700; text-decoration: none;" %>
        <span style="color: #C8EFEB;">|</span>
        <%= link_to "新規登録", new_registration_path(resource_name),
              style: "font-size: 13px; color: #0ABFA3; font-weight: 700; text-decoration: none;" %>
      </div>
    </div>

  </div>
</div>
