<%# app/views/devise/registrations/new.html.erb %>

<div style="background-color: #F7FFFE; min-height: calc(100vh - 120px); display: flex; align-items: center; justify-content: center; padding: 40px 16px;">
  <div style="width: 100%; max-width: 440px;">

    <%# ─── ロゴ・キャッチ ─── %>
    <div style="text-align: center; margin-bottom: 28px;">
      <h1 style="font-size: 28px; font-weight: 800; font-family: 'Syne', sans-serif; background: linear-gradient(135deg, #0ABFA3, #00C8D7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0 0 6px;">ThinkStorm</h1>
      <p style="font-size: 13px; color: #4A6972; margin: 0;">AIと協働するブレインストーミング</p>
    </div>

    <%# ─── カード ─── %>
    <div class="ts-section-card">
      <h2 style="font-size: 20px; font-weight: 700; color: #0F2027; text-align: center; margin: 0 0 24px;">新規登録</h2>

      <%# SNS登録 %>
      <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px;">
        <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false },
              style: "width: 100%; background: none; border: none; padding: 0; cursor: pointer;" do %>
          <div style="display: flex; align-items: center; justify-content: center; gap: 10px; padding: 11px 16px; border: 1.5px solid #C8EFEB; border-radius: 10px; background: #FFFFFF; transition: background 0.15s; font-size: 14px; font-weight: 600; color: #0F2027; font-family: inherit;"
               onmouseover="this.style.background='#F0FAFA'" onmouseout="this.style.background='#FFFFFF'">
            <svg style="width:20px;height:20px;flex-shrink:0;" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Googleで始める
          </div>
        <% end %>

        <%= button_to user_line_omniauth_authorize_path, method: :post, data: { turbo: false },
              style: "width: 100%; background: none; border: none; padding: 0; cursor: pointer;" do %>
          <div style="display: flex; align-items: center; justify-content: center; gap: 10px; padding: 11px 16px; border: 1.5px solid #C8EFEB; border-radius: 10px; background: #FFFFFF; transition: background 0.15s; font-size: 14px; font-weight: 600; color: #0F2027; font-family: inherit;"
               onmouseover="this.style.background='#F0FAFA'" onmouseout="this.style.background='#FFFFFF'">
            <svg style="width:20px;height:20px;flex-shrink:0;" viewBox="0 0 24 24">
              <path fill="#06C755" d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.070 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
            LINEで始める
          </div>
        <% end %>
      </div>

      <%# 区切り線 %>
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
        <div style="flex: 1; height: 1px; background: #C8EFEB;"></div>
        <span style="font-size: 12px; color: #9BB5BC; white-space: nowrap;">メールアドレスで登録</span>
        <div style="flex: 1; height: 1px; background: #C8EFEB;"></div>
      </div>

      <%# メールフォーム %>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div style="margin-bottom: 16px;">
          <%= f.label :email, "メールアドレス",
                style: "display: block; font-size: 13px; font-weight: 700; color: #0F2027; margin-bottom: 6px;" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                style: "width: 100%; border: 1.5px solid #C8EFEB; border-radius: 10px; padding: 10px 14px; font-size: 14px; color: #0F2027; background: #FFFFFF; outline: none; font-family: inherit; box-sizing: border-box; transition: border-color 0.2s;",
                onfocus: "this.style.borderColor='#0ABFA3'",
                onblur: "this.style.borderColor='#C8EFEB'" %>
        </div>

        <div style="margin-bottom: 16px;">
          <%= f.label :password, "パスワード",
                style: "display: block; font-size: 13px; font-weight: 700; color: #0F2027; margin-bottom: 6px;" %>
          <% if @minimum_password_length %>
            <span style="font-size: 12px; color: #9BB5BC; display: block; margin-bottom: 5px;">最低 <%= @minimum_password_length %> 文字</span>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password",
                style: "width: 100%; border: 1.5px solid #C8EFEB; border-radius: 10px; padding: 10px 14px; font-size: 14px; color: #0F2027; background: #FFFFFF; outline: none; font-family: inherit; box-sizing: border-box; transition: border-color 0.2s;",
                onfocus: "this.style.borderColor='#0ABFA3'",
                onblur: "this.style.borderColor='#C8EFEB'" %>
        </div>

        <div style="margin-bottom: 22px;">
          <%= f.label :password_confirmation, "パスワード（確認）",
                style: "display: block; font-size: 13px; font-weight: 700; color: #0F2027; margin-bottom: 6px;" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                style: "width: 100%; border: 1.5px solid #C8EFEB; border-radius: 10px; padding: 10px 14px; font-size: 14px; color: #0F2027; background: #FFFFFF; outline: none; font-family: inherit; box-sizing: border-box; transition: border-color 0.2s;",
                onfocus: "this.style.borderColor='#0ABFA3'",
                onblur: "this.style.borderColor='#C8EFEB'" %>
        </div>

        <%= f.submit "登録する",
              style: "width: 100%; padding: 12px; background: linear-gradient(135deg, #0ABFA3, #00C8D7); color: white; border: none; border-radius: 10px; font-size: 15px; font-weight: 700; cursor: pointer; font-family: inherit; transition: opacity 0.2s;",
              onmouseover: "this.style.opacity='0.88'",
              onmouseout: "this.style.opacity='1'" %>
      <% end %>

      <%# フッターリンク %>
      <div style="text-align: center; margin-top: 20px;">
        <span style="font-size: 13px; color: #4A6972;">
          すでにアカウントをお持ちの方は
          <%= link_to "ログイン", new_session_path(resource_name),
                style: "color: #0ABFA3; font-weight: 700; text-decoration: none;" %>
        </span>
      </div>
    </div>

  </div>
</div>
