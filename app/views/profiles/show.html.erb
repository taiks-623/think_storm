<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-8">アカウント設定</h1>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-700 mb-4">アカウント情報</h2>
    <dl class="space-y-3">
      <div class="flex justify-between">
        <dt class="text-gray-500">メールアドレス</dt>
        <dd class="text-gray-900"><%= current_user.email %></dd>
      </div>
      <% if current_user.provider.present? %>
        <div class="flex justify-between">
          <dt class="text-gray-500">ログイン方法</dt>
          <dd class="text-gray-900"><%= current_user.provider.humanize %></dd>
        </div>
      <% end %>
    </dl>
    <%= link_to "編集する", edit_profile_path, class: "mt-4 inline-block text-blue-600 hover:underline" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-red-600 mb-4">危険な操作</h2>
    <%= button_to "アカウントを削除する", cancel_profile_path, method: :delete,
        data: { turbo_confirm: "本当に削除しますか？この操作は取り消せません。" },
        class: "bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700" %>
  </div>
</div>