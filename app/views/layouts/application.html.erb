<!DOCTYPE html>
<html>
  <head>
    <title>ThinkStorm</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# OGP基本タグ %>
    <meta property="og:site_name" content="ThinkStorm">
    <meta property="og:title" content="<%= content_for?(:og_title) ? yield(:og_title) : 'ThinkStorm' %>">
    <meta property="og:description" content="<%= content_for?(:og_description) ? yield(:og_description) : 'AIと協働するブレインストーミング支援プラットフォーム' %>">
    <meta property="og:type" content="<%= content_for?(:og_type) ? yield(:og_type) : 'website' %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="https://thinkstorm.jp/images/ogp.png">
    <meta property="og:locale" content="ja_JP">

    <%# Twitter Card %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:og_title) ? yield(:og_title) : 'ThinkStorm' %>">
    <meta name="twitter:description" content="<%= content_for?(:og_description) ? yield(:og_description) : 'AIと協働するブレインストーミング支援プラットフォーム' %>">
    <meta name="twitter:image" content="https://thinkstorm.jp/images/ogp.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/chart.js", defer: true %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;700&family=Syne:wght@700;800&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
  </head>

  <body class="flex flex-col min-h-screen" style="background-color: #0F2027;">

    <%# ローディングオーバーレイ %>
    <div id="loading-overlay" 
        style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; z-index:9999; background:rgba(255,255,255,0.85); flex-direction:column; align-items:center; justify-content:center;">
      <div style="display:flex; flex-direction:column; align-items:center; gap:1rem;">
        <div style="width:48px; height:48px; border:4px solid #c7d2fe; border-top-color:#4f46e5; border-radius:50%; animation:spin 0.8s linear infinite;"></div>
        <p id="loading-message" style="color:#4f46e5; font-weight:600; font-size:1.125rem;">処理中...</p>
      </div>
    </div>

    <style>
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
    </style>

    <div data-controller="loading" data-loading-overlay-id="loading-overlay"
     class="flex flex-col flex-1">
      <%= render "shared/header" %>
      
      <main class="min-w-0" style="background-color: #F7FFFE; flex: 1 0 auto;">
        <% if notice %>
          <div class="ts-flash-notice"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="ts-flash-alert"><%= alert %></div>
        <% end %>
        
        <%= yield %>
      </main>
      
      <%= render "shared/footer" %>
      </div>
      <script>
        function showLoading(message) {
          document.getElementById("loading-message").textContent = message || "処理中..."
          const overlay = document.getElementById("loading-overlay")
          overlay.style.display = "flex"
          window.addEventListener("pageshow", function() {
            overlay.style.display = "none"
          })
        }
      </script>
      <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
  </body>
</html>
