<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-800">マイブレスト</h1>
    <%= link_to "新規作成", new_brainstorm_path, class: "px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition" %>
  </div>

  <%# 検索フォーム %>
  <div data-controller="autocomplete"
      data-action="click@window->autocomplete#clickOutside">
    <%= form_with url: dashboard_path, method: :get, local: true do |f| %>
      <div class="flex gap-2">
        <div class="relative flex-grow">
          <%= f.text_field :q,
                value: params[:q],
                placeholder: "ブレストを検索...",
                autocomplete: "off",
                data: {
                  autocomplete_target: "input",
                  action: "input->autocomplete#search"
                },
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>

          <%# 候補ドロップダウン %>
          <div data-autocomplete-target="suggestions"
              class="hidden absolute z-10 w-full bg-white border border-gray-200 rounded-lg shadow-lg mt-1">
          </div>
        </div>

        <%= f.submit "検索",
              class: "px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition cursor-pointer" %>
        <% if params[:q].present? %>
          <%= link_to "クリア", dashboard_path,
                class: "px-4 py-2 bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200 transition" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# 検索結果のメッセージ %>
  <% if params[:q].present? %>
    <p class="text-sm text-gray-500 mb-4">
      「<%= params[:q] %>」の検索結果：<%= @brainstorms.count %>件
    </p>
  <% end %>

  <% if @brainstorms.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @brainstorms.each do |brainstorm| %>
        <div class="bg-white rounded-lg shadow hover:shadow-lg transition p-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-2">
            <%= link_to brainstorm.title, brainstorm_path(brainstorm), class: "hover:text-indigo-600" %>
          </h2>
          
          <% if brainstorm.description.present? %>
            <p class="text-gray-600 mb-4 line-clamp-2">
              <%= brainstorm.description %>
            </p>
          <% end %>
          
          <div class="flex justify-between items-center text-sm text-gray-500">
            <span><%= brainstorm.created_at.strftime("%Y/%m/%d") %></span>
            <div class="space-x-2">
              <%= link_to "詳細", brainstorm_path(brainstorm), class: "text-indigo-600 hover:text-indigo-800" %>
              <%= button_to "削除", brainstorm_path(brainstorm), method: :delete, form: { onsubmit: "return confirm('本当に削除しますか？')" }, class: "text-red-600 hover:text-red-800 text-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-50 rounded-lg p-12 text-center">
      <p class="text-gray-600 text-lg mb-4">まだブレストがありません</p>
      <%= link_to "最初のブレストを作成", new_brainstorm_path, class: "px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition inline-block" %>
    </div>
  <% end %>
</div>
