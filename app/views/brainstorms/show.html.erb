<% content_for :og_title, "#{@brainstorm.title} | ThinkStorm" %>
<% content_for :og_description, "#{@brainstorm.ideas.count}個のアイデアが生成されました" %>
<% content_for :og_type, "article" %>
<span id="chart-reinit-flag"></span>

<div class="ts-brainstorm-show" data-brainstorm-id="<%= @brainstorm.id %>">

  <%# ─── ブレストヘッダー ─── %>
  <div class="ts-section-card">
    <div class="ts-brainstorm-header">
      <div class="flex-grow">
        <h1 class="ts-brainstorm-title"><%= @brainstorm.title %></h1>
        <% if @brainstorm.description.present? %>
          <p class="ts-brainstorm-desc"><%= @brainstorm.description %></p>
        <% end %>
        <p class="ts-brainstorm-date">作成日: <%= @brainstorm.created_at.strftime("%Y年%m月%d日") %></p>

        <%# メンバー %>
        <div class="ts-members-row">
          <span class="ts-members-label">メンバー：</span>
          <span class="ts-member-badge ts-member-badge-owner">
            <%= @brainstorm.user.display_name %>
            <span class="ts-member-role ts-role-owner">オーナー</span>
          </span>
          <% @brainstorm.brainstorm_members.includes(:user).each do |member| %>
            <span class="ts-member-badge <%= member.role == 'editor' ? 'ts-member-badge-editor' : 'ts-member-badge-viewer' %>">
              <%= member.user.display_name %>
              <span class="ts-member-role <%= member.role == 'editor' ? 'ts-role-editor' : 'ts-role-viewer' %>">
                <%= member.role == 'editor' ? '編集者' : '閲覧者' %>
              </span>
            </span>
          <% end %>
        </div>
      </div>

      <div class="flex flex-col items-end gap-3">
        <%# オンラインメンバー %>
        <div class="ts-online-row">
          <span class="ts-online-label">オンライン：</span>
          <div id="online-members" class="flex flex-wrap gap-2"></div>
        </div>

        <%# アクション %>
        <div class="ts-header-actions">
          <% if @brainstorm.owner?(current_user) %>
            <%= link_to "招待", invite_brainstorm_path(@brainstorm), class: "ts-btn ts-btn-ghost ts-btn-sm" %>
            <%= link_to "編集", edit_brainstorm_path(@brainstorm), class: "ts-btn ts-btn-ghost ts-btn-sm" %>
            <%= link_to "MDエクスポート", export_markdown_brainstorm_path(@brainstorm), class: "ts-btn ts-btn-green ts-btn-sm" %>
            <%= button_to "削除", brainstorm_path(@brainstorm), method: :delete,
                  form: { onsubmit: "return confirm('本当に削除しますか？')" },
                  class: "ts-btn ts-btn-danger ts-btn-sm" %>
          <% elsif @brainstorm.editor?(current_user) %>
            <%= link_to "MDエクスポート", export_markdown_brainstorm_path(@brainstorm), class: "ts-btn ts-btn-green ts-btn-sm" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# ─── 評価軸 ─── %>
  <div class="ts-section-card">
    <h2 class="ts-section-heading">📊 評価軸</h2>
    <div id="evaluation_axes" class="mb-4">
      <% @brainstorm.evaluation_axes.order(:position, :created_at).each do |axis| %>
        <%= render "evaluation_axes/evaluation_axis", evaluation_axis: axis, brainstorm: @brainstorm %>
      <% end %>
    </div>
    <%= render "evaluation_axes/form", brainstorm: @brainstorm, evaluation_axis: EvaluationAxis.new %>
  </div>

  <%# ─── 評価結果 ─── %>
  <%= render "brainstorms/evaluation_panel", brainstorm: @brainstorm %>

  <%# ─── アイデア一覧 ─── %>
  <div class="ts-section-card">
    <div class="ts-ideas-header">
      <h2 class="ts-ideas-title">アイデア一覧</h2>

      <%# タグ絞り込み %>
      <% if @tags.any? %>
        <div class="ts-tag-filter">
          <span class="ts-tag-filter-label">タグ：</span>
          <% if @selected_tag %>
            <%= link_to "すべて", brainstorm_path(@brainstorm), class: "ts-tag-pill ts-tag-pill-all" %>
          <% end %>
          <% @tags.each do |tag| %>
            <%= link_to tag.name, brainstorm_path(@brainstorm, tag_id: tag.id),
                  class: "ts-tag-pill #{@selected_tag&.id == tag.id ? 'ts-tag-pill-active' : ''}" %>
          <% end %>
        </div>
      <% end %>

      <% if @brainstorm.editor?(current_user) %>
        <div class="ts-ideas-actions">
          <button onclick="document.getElementById('add-idea-form').classList.toggle('hidden')"
              class="ts-btn ts-btn-ghost ts-btn-sm">
            アイデアを手動追加
          </button>
          <%= form_with url: generate_brainstorm_ideas_path(@brainstorm), method: :post,
                class: "inline-block", id: "generate-form", data: { turbo: false } do |f| %>
            <button type="submit" class="ts-btn ts-btn-mint ts-btn-sm"
                onclick="showLoading('AIがアイデアを生成中です...')">
              AIでアイデア生成
            </button>
          <% end %>
          <% if @brainstorm.ideas.any? %>
            <%= form_with url: cluster_brainstorm_groups_path(@brainstorm), method: :post,
                  class: "inline-block", id: "cluster-form", data: { turbo: false } do |f| %>
              <button type="submit" class="ts-btn ts-btn-purple ts-btn-sm"
                  onclick="showLoading('AIがアイデアを分類中です...')">
                AIクラスタリング実行
              </button>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# 手動追加フォーム %>
    <div id="add-idea-form" class="hidden ts-add-idea-form">
      <%= form_with(model: [@brainstorm, @brainstorm.ideas.build], local: true) do |f| %>
        <div class="mb-4">
          <%= f.label :content, "アイデア内容", class: "ts-form-label" %>
          <%= f.text_area :content, rows: 3, class: "ts-form-textarea",
                placeholder: "アイデアを入力してください" %>
        </div>
        <div class="mb-4">
          <%= f.label :memo, "メモ（任意）", class: "ts-form-label" %>
          <%= f.text_area :memo, rows: 2, class: "ts-form-textarea",
                placeholder: "補足や詳細など" %>
        </div>
        <div class="flex justify-end gap-2">
          <button type="button"
              onclick="document.getElementById('add-idea-form').classList.add('hidden')"
              class="ts-btn ts-btn-ghost ts-btn-sm">
            キャンセル
          </button>
          <%= f.submit "追加", class: "ts-btn ts-btn-mint ts-btn-sm cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <% if @brainstorm.ideas.where.not(id: nil).any? %>
      <% if @brainstorm.groups.any? && @selected_tag.nil? %>

        <%# グループ操作 %>
        <div class="ts-group-actions">
          <button onclick="document.getElementById('new-group-form').classList.toggle('hidden')"
              class="ts-btn ts-btn-green ts-btn-sm">
            ＋ 新しいグループを作成
          </button>
          <%= form_with url: reset_clustering_brainstorm_groups_path(@brainstorm),
                method: :delete, id: "reset-clustering-form", data: { turbo: false } do |f| %>
            <button type="submit"
                class="ts-btn ts-btn-ghost ts-btn-sm"
                onclick="if(!confirm('クラスタリングをやり直します。現在のグループ分けはすべて削除されます。よろしいですか？')) { return false; } showLoading('AIがアイデアを分類中です...')">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              やり直し
            </button>
          <% end %>
        </div>

        <%# 新規グループ作成フォーム %>
        <div id="new-group-form" class="hidden ts-new-group-form">
          <%= form_with(model: [@brainstorm, @brainstorm.groups.build], local: true) do |f| %>
            <div class="mb-4">
              <%= f.label :name, "グループ名", class: "ts-form-label" %>
              <%= f.text_field :name, class: "ts-axis-input w-full",
                    placeholder: "例：その他のアイデア", maxlength: 50 %>
            </div>
            <div class="flex justify-end gap-2">
              <button type="button"
                  onclick="document.getElementById('new-group-form').classList.add('hidden')"
                  class="ts-btn ts-btn-ghost ts-btn-sm">
                キャンセル
              </button>
              <%= f.submit "作成", class: "ts-btn ts-btn-mint ts-btn-sm cursor-pointer" %>
            </div>
          <% end %>
        </div>

        <%# グループ表示 %>
        <div class="space-y-4">
          <% @brainstorm.groups.order(:position).each do |group| %>
            <div class="ts-group-block">
              <div class="ts-group-header">
                <h3 class="ts-group-name"><%= group.name %></h3>
                <div class="ts-group-actions-right">
                  <button onclick="document.getElementById('edit-group-<%= group.id %>').classList.toggle('hidden')"
                      class="ts-btn ts-btn-ghost ts-btn-xs">
                    グループ名編集
                  </button>
                  <%= button_to "削除", brainstorm_group_path(@brainstorm, group),
                        method: :delete,
                        data: { turbo_confirm: "グループを削除しますか？" },
                        class: "ts-btn ts-btn-danger ts-btn-xs" %>
                </div>
              </div>

              <div id="edit-group-<%= group.id %>" class="hidden ts-group-edit-form">
                <%= form_with(model: [@brainstorm, group], local: true, class: "flex items-center gap-2 w-full") do |f| %>
                  <%= f.text_field :name, class: "ts-group-edit-input" %>
                  <%= f.submit "更新", class: "ts-btn ts-btn-mint ts-btn-sm cursor-pointer" %>
                  <button type="button"
                      onclick="document.getElementById('edit-group-<%= group.id %>').classList.add('hidden')"
                      class="ts-btn ts-btn-ghost ts-btn-sm">
                    キャンセル
                  </button>
                <% end %>
              </div>

              <div class="space-y-2 sortable-ideas"
                  data-group-id="<%= group.id %>"
                  data-brainstorm-id="<%= @brainstorm.id %>">
                <% group.ideas.each do |idea| %>
                  <%= render "ideas/idea_card", idea: idea, brainstorm: @brainstorm, current_group: group %>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# 未分類 %>
          <% ungrouped_ideas = @brainstorm.ideas.where.not(id: nil).left_joins(:idea_groups).where(idea_groups: { id: nil }) %>
          <% if ungrouped_ideas.any? %>
            <div class="ts-group-block ts-group-block-ungrouped">
              <h3 class="ts-group-name ts-group-name-ungrouped">未分類のアイデア</h3>
              <div class="space-y-2 sortable-ideas"
                  data-group-id=""
                  data-brainstorm-id="<%= @brainstorm.id %>">
                <% ungrouped_ideas.each do |idea| %>
                  <%= render "ideas/idea_card", idea: idea, brainstorm: @brainstorm, current_group: nil %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

      <% else %>
        <div class="space-y-3" id="ideas-list">
          <% ideas_to_show = @filtered_ideas || @brainstorm.ideas.where.not(id: nil) %>
          <% ideas_to_show.each do |idea| %>
            <%= render "ideas/idea_card", idea: idea, brainstorm: @brainstorm, current_group: nil %>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <div class="ts-empty-ideas">
        <p class="font-semibold text-lg mb-2">まだアイデアがありません</p>
        <p class="text-sm mb-6">AIにアイデアを生成させるか、手動でアイデアを追加してください</p>
        <div class="flex justify-center gap-3 flex-wrap">
          <%= form_with url: generate_brainstorm_ideas_path(@brainstorm), method: :post,
                class: "inline-block", id: "generate-form-bottom", data: { turbo: false } do |f| %>
            <button type="submit" class="ts-btn ts-btn-mint"
                onclick="showLoading('AIがアイデアを生成中です...')">
              AIでアイデア生成
            </button>
          <% end %>
          <button onclick="document.getElementById('add-idea-form').classList.remove('hidden')"
              class="ts-btn ts-btn-ghost">
            手動で追加
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <%= link_to "← ダッシュボードに戻る", dashboard_path, class: "ts-back-link" %>

</div>

<%# Chart.js + Sortable.js のスクリプトは元のままコピー %>
<script>
  var charts = {};

  function initCharts() {
    document.querySelectorAll('canvas[id^="radar-chart-"]').forEach(function(canvas) {
      const ideaId = canvas.id.replace('radar-chart-', '');
      const axisIds = canvas.dataset.axisIds ? canvas.dataset.axisIds.split(',') : [];
      const axisLabels = canvas.dataset.axisLabels ? canvas.dataset.axisLabels.split(',') : [];
      if (axisIds.length < 2) return;

      const card = document.querySelector(`.chart-card[data-idea-id="${ideaId}"]`);
      const scores = axisIds.map(axisId => {
        if (!card) return 0;
        const axisScores = card.dataset.axisScores.split(',').map(s => s.split(':'));
        const found = axisScores.find(([aId]) => aId === axisId);
        return found ? parseInt(found[1]) : 0;
      });

      if (charts[ideaId]) charts[ideaId].destroy();

      charts[ideaId] = new Chart(canvas, {
        type: 'radar',
        data: {
          labels: axisLabels,
          datasets: [{
            data: scores,
            backgroundColor: 'rgba(10, 191, 163, 0.15)',
            borderColor: 'rgba(10, 191, 163, 1)',
            borderWidth: 2,
            pointBackgroundColor: 'rgba(10, 191, 163, 1)',
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            r: {
              min: 0, max: 5,
              ticks: { stepSize: 1, font: { size: 10 } },
              pointLabels: { font: { size: 11 } }
            }
          }
        }
      });
    });
  }

  function updateChart(ideaId, axisId, score) {
    const canvas = document.getElementById(`radar-chart-${ideaId}`);
    if (!canvas) return;

    const axisIds = canvas.dataset.axisIds.split(',');
    const axisIndex = axisIds.indexOf(String(axisId));
    if (axisIndex === -1) return;

    if (charts[ideaId]) {
      charts[ideaId].data.datasets[0].data[axisIndex] = parseInt(score);
      charts[ideaId].update();
    } else {
      const labels = canvas.dataset.axisLabels ? canvas.dataset.axisLabels.split(',') : axisIds;
      const scores = axisIds.map((id, i) => i === axisIndex ? parseInt(score) : 0);
      charts[ideaId] = new Chart(canvas, {
        type: 'radar',
        data: {
          labels: labels,
          datasets: [{
            data: scores,
            backgroundColor: 'rgba(10, 191, 163, 0.15)',
            borderColor: 'rgba(10, 191, 163, 1)',
            borderWidth: 2,
            pointBackgroundColor: 'rgba(10, 191, 163, 1)',
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            r: {
              min: 0, max: 5,
              ticks: { stepSize: 1, font: { size: 10 } },
              pointLabels: { font: { size: 11 } }
            }
          }
        }
      });
    }

    const card = document.querySelector(`.chart-card[data-idea-id="${ideaId}"]`);
    if (card) {
      const axisScores = card.dataset.axisScores.split(',').map(s => s.split(':'));
      const updated = axisScores.map(([aId, aScore]) => [aId, aId === String(axisId) ? parseInt(score) : parseInt(aScore)]);
      const total = updated.reduce((sum, [, s]) => sum + s, 0);
      card.dataset.totalScore = total;
      card.dataset.axisScores = updated.map(([aId, aScore]) => `${aId}:${aScore}`).join(',');
      const label = card.querySelector('.total-score-label');
      if (label) label.textContent = total;
    }
  }

  function applyFilter() {
    const axisId = document.getElementById('sort-axis')?.value;
    const order = document.getElementById('sort-order')?.value || 'desc';
    const minScore = parseInt(document.getElementById('min-score')?.value || '0');
    const hideUnevaluated = document.getElementById('hide-unevaluated')?.checked || false;

    const grid = document.getElementById('chart-grid');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll('.chart-card'));

    cards.forEach(card => {
      const hasEvaluation = card.dataset.hasEvaluation === 'true';
      let score = 0;
      if (axisId) {
        const axisScores = card.dataset.axisScores.split(',').map(s => s.split(':'));
        const found = axisScores.find(([aId]) => aId === axisId);
        score = found ? parseInt(found[1]) : 0;
      } else {
        score = parseInt(card.dataset.totalScore);
      }
      const hidden = (hideUnevaluated && !hasEvaluation) || (score < minScore);
      card.style.display = hidden ? 'none' : '';
    });

    const visibleCards = cards.filter(c => c.style.display !== 'none');
    visibleCards.sort((a, b) => {
      const getScore = (card) => {
        if (axisId) {
          const axisScores = card.dataset.axisScores.split(',').map(s => s.split(':'));
          const found = axisScores.find(([aId]) => aId === axisId);
          return found ? parseInt(found[1]) : 0;
        }
        return parseInt(card.dataset.totalScore);
      };
      return order === 'desc' ? getScore(b) - getScore(a) : getScore(a) - getScore(b);
    });

    visibleCards.forEach(card => grid.appendChild(card));
  }

  document.addEventListener('turbo:load', initCharts);

  document.addEventListener('turbo:before-stream-render', function(event) {
    const originalRender = event.detail.render;
    event.detail.render = function(streamElement) {
      originalRender(streamElement);
      if (streamElement.target === 'chart-reinit-flag') {
        setTimeout(function() {
          Object.values(charts).forEach(chart => chart.destroy());
          Object.keys(charts).forEach(key => delete charts[key]);
          initCharts();
        }, 100);
      }
    };
  });

  document.addEventListener('turbo:load', function() {
    const sortableContainers = document.querySelectorAll('.sortable-ideas');
    sortableContainers.forEach(function(container) {
      if (container.dataset.sortableInitialized) return;
      container.dataset.sortableInitialized = 'true';
      new Sortable(container, {
        group: 'ideas',
        animation: 150,
        ghostClass: 'opacity-50',
        draggable: '.idea-card',
        onEnd: function(evt) {
          const ideaId = evt.item.dataset.ideaId;
          const newGroupId = evt.to.dataset.groupId;
          const brainstormId = evt.to.dataset.brainstormId;
          const url = '/brainstorms/' + brainstormId + '/ideas/' + ideaId + '/update_group';
          fetch(url, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ group_id: newGroupId })
          })
          .then(response => {
            if (response.ok) {
              const selectElement = evt.item.querySelector('select');
              if (selectElement) selectElement.value = newGroupId || '';
            }
          })
          .catch(error => console.error('Error:', error));
        }
      });
    });
  });
</script>
