<% content_for :og_title, "#{@brainstorm.title} | ThinkStorm" %>
<% content_for :og_description, "#{@brainstorm.ideas.count}個のアイデアが生成されました" %>
<% content_for :og_type, "article" %>

<div class="container mx-auto px-4 py-8">
  <!-- ヘッダー部分 -->
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <div class="flex justify-between items-start mb-4">
      <div class="flex-grow">
        <h1 class="text-3xl font-bold text-gray-800 mb-2"><%= @brainstorm.title %></h1>
        <% if @brainstorm.description.present? %>
          <p class="text-gray-600 mb-4"><%= @brainstorm.description %></p>
        <% end %>
        <p class="text-sm text-gray-500">作成日: <%= @brainstorm.created_at.strftime("%Y年%m月%d日") %></p>
      </div>
      
      <div class="flex space-x-2">
        <%= link_to "編集", edit_brainstorm_path(@brainstorm), class: "px-4 py-2 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition" %>
        <%= button_to "削除", brainstorm_path(@brainstorm), method: :delete, form: { onsubmit: "return confirm('本当に削除しますか？')" }, class: "px-4 py-2 bg-red-100 text-red-700 rounded hover:bg-red-200 transition" %>
      </div>
    </div>
  </div>

  <!-- アイデア一覧セクション -->
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-800">アイデア一覧</h2>
      <div class="space-x-2">
        <button onclick="document.getElementById('add-idea-form').classList.toggle('hidden')" class="px-4 py-2 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition">
          アイデアを手動追加
        </button>
        
        <%= form_with url: generate_brainstorm_ideas_path(@brainstorm), method: :post, class: "inline-block", id: "generate-form", data: { turbo: false } do |f| %>
          <button type="submit"
              class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 transition cursor-pointer"
              onclick="showLoading('AIがアイデアを生成中です...')">
            AIでアイデア生成
          </button>
        <% end %>
        
        <% if @brainstorm.ideas.any? %>
          <%= form_with url: cluster_brainstorm_groups_path(@brainstorm), method: :post, class: "inline-block", id: "cluster-form", data: { turbo: false } do |f| %>
            <button type="submit"
                class="px-4 py-2 rounded transition cursor-pointer"
                style="background-color: #9333ea; color: white; border: none;"
                onclick="showLoading('AIがアイデアを分類中です...')">
              AIクラスタリング実行
            </button>
          <% end %>
        <% end %>

      </div>
    </div>

    <!-- 手動追加フォーム -->
    <div id="add-idea-form" class="hidden mb-6 bg-gray-50 rounded-lg p-4">
      <%= form_with(model: [@brainstorm, @brainstorm.ideas.build], local: true) do |f| %>
        <div class="mb-4">
          <%= f.label :content, "アイデア内容", class: "block text-gray-700 font-semibold mb-2" %>
          <%= f.text_area :content, rows: 3, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "アイデアを入力してください" %>
        </div>
        <div class="mb-4">
          <%= f.label :memo, "メモ（任意）", class: "block text-gray-700 font-semibold mb-2" %>
          <%= f.text_area :memo, rows: 2, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "補足や詳細など" %>
        </div>
        <div class="flex justify-end space-x-2">
          <button type="button" onclick="document.getElementById('add-idea-form').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:text-gray-800">
            キャンセル
          </button>
          <%= f.submit "追加", class: "px-6 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 transition cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <% if @brainstorm.ideas.where.not(id: nil).any? %>
      <% if @brainstorm.groups.any? %>
        <!-- グループ操作ボタン -->
        <div class="flex justify-between items-center mb-4">
          <button onclick="document.getElementById('new-group-form').classList.toggle('hidden')"
              class="px-4 py-2 bg-green-100 text-green-700 rounded hover:bg-green-200 transition">
            + 新しいグループを作成
          </button>

          <%= form_with url: reset_clustering_brainstorm_groups_path(@brainstorm),
                method: :delete,
                id: "reset-clustering-form",
                data: { turbo: false } do |f| %>
            <button type="submit"
                class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition cursor-pointer"
                onclick="if(!confirm('クラスタリングをやり直します。\n現在のグループ分けはすべて削除され、AIが再度グループ分けを行います。\nよろしいですか？')) { return false; } showLoading('AIがアイデアを分類中です...')">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              やり直し
            </button>
          <% end %>
        </div>

        <!-- 新規グループ作成フォーム（デフォルトは非表示） -->
        <div id="new-group-form" class="hidden mb-6 bg-gray-50 rounded-lg p-4">
          <%= form_with(model: [@brainstorm, @brainstorm.groups.build], local: true) do |f| %>
            <div class="mb-4">
              <%= f.label :name, "グループ名", class: "block text-gray-700 font-semibold mb-2" %>
              <%= f.text_field :name, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "例：その他のアイデア", maxlength: 50 %>
            </div>
            <div class="flex justify-end space-x-2">
              <button type="button" onclick="document.getElementById('new-group-form').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:text-gray-800">
                キャンセル
              </button>
              <%= f.submit "作成", 
                class: "px-6 py-2 rounded cursor-pointer",
                style: "background-color: #16a34a; color: white; border: none;",
                onmouseover: "this.style.backgroundColor='#15803d'",
                onmouseout: "this.style.backgroundColor='#16a34a'" %>
            </div>
          <% end %>
        </div>

        <!-- グループ表示 -->
        <div class="space-y-6">
          <% @brainstorm.groups.order(:position).each do |group| %>
            <div class="border-2 border-gray-300 rounded-lg p-4">
              <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-bold text-gray-800"><%= group.name %></h3>
                <div class="space-x-2">
                  <button onclick="document.getElementById('edit-group-<%= group.id %>').classList.toggle('hidden')" class="text-indigo-600 hover:text-indigo-800 text-sm">
                    グループ名編集
                  </button>
                  <%= button_to "削除", brainstorm_group_path(@brainstorm, group), method: :delete, data: { turbo_confirm: "グループを削除しますか？" }, class: "text-red-600 hover:text-red-800 text-sm" %>
                </div>
              </div>
              
              <!-- グループ名編集フォーム -->
              <div id="edit-group-<%= group.id %>" class="hidden mb-4 bg-gray-50 p-3 rounded">
                <%= form_with(model: [@brainstorm, group], local: true, class: "flex items-center space-x-2") do |f| %>
                  <%= f.text_field :name, class: "flex-grow px-3 py-2 border rounded" %>
                  <%= f.submit "更新", 
                    class: "px-4 py-2 rounded cursor-pointer",
                    style: "background-color: #4f46e5; color: white; border: none;",
                    onmouseover: "this.style.backgroundColor='#4338ca'",
                    onmouseout: "this.style.backgroundColor='#4f46e5'" %>
                  <button type="button" onclick="document.getElementById('edit-group-<%= group.id %>').classList.add('hidden')" class="px-4 py-2 text-gray-600">
                    キャンセル
                  </button>
                <% end %>
              </div>
              
              <!-- グループ内のアイデア -->
              <div class="space-y-3 sortable-ideas" data-group-id="<%= group.id %>" data-brainstorm-id="<%= @brainstorm.id %>">
                <% group.ideas.each do |idea| %>
                  <div class="bg-white border border-gray-200 rounded p-3 idea-card" data-idea-id="<%= idea.id %>">
                    <div class="flex justify-between items-start">
                      <div class="flex-grow">
                        <p class="text-gray-800"><%= idea.content %></p>
                        <% if idea.memo.present? %>
                          <p class="text-sm text-gray-500 mt-1"><%= idea.memo %></p>
                        <% end %>
                      </div>
                      <div class="flex items-center space-x-2 ml-4">
                        <span class="px-2 py-1 text-xs rounded <%= idea.source == 'ai' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
                          <%= idea.source == 'ai' ? 'AI生成' : '手動追加' %>
                        </span>
                        
                        <!-- グループ移動セレクトボックス -->
                        <%= form_with url: brainstorm_update_group_idea_path(@brainstorm, idea), method: :patch, local: true, class: "inline-block" do |f| %>
                          <%= f.select :group_id, 
                            options_for_select(
                              [["グループなし", ""]] + @brainstorm.groups.where.not(name: [nil, ""]).map { |g| [g.name, g.id] },
                              group.id
                            ),
                            {},
                            class: "text-sm border rounded px-2 py-1",
                            onchange: "this.form.submit();" %>
                        <% end %>
                        
                        <%= link_to "編集", edit_brainstorm_idea_path(@brainstorm, idea), class: "text-indigo-600 hover:text-indigo-800 text-sm" %>
                        <%= button_to "削除", brainstorm_idea_path(@brainstorm, idea), method: :delete, data: { turbo_confirm: "削除しますか？" }, class: "text-red-600 hover:text-red-800 text-sm" %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
          
          <!-- グループ化されていないアイデア -->
          <% ungrouped_ideas = @brainstorm.ideas.where.not(id: nil).left_joins(:idea_groups).where(idea_groups: { id: nil }) %>
          <% if ungrouped_ideas.any? %>
            <div class="border-2 border-dashed border-gray-300 rounded-lg p-4">
              <h3 class="text-xl font-bold text-gray-600 mb-4">未分類のアイデア</h3>
              <div class="space-y-3 sortable-ideas" data-group-id="" data-brainstorm-id="<%= @brainstorm.id %>">
                <% ungrouped_ideas.each do |idea| %>
                  <div class="bg-white border border-gray-200 rounded p-3 idea-card" data-idea-id="<%= idea.id %>">
                    <div class="flex justify-between items-start">
                      <div class="flex-grow">
                        <p class="text-gray-800"><%= idea.content %></p>
                        <% if idea.memo.present? %>
                          <p class="text-sm text-gray-500 mt-1"><%= idea.memo %></p>
                        <% end %>
                      </div>
                      <div class="flex items-center space-x-2 ml-4">
                        <span class="px-2 py-1 text-xs rounded <%= idea.source == 'ai' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
                          <%= idea.source == 'ai' ? 'AI生成' : '手動追加' %>
                        </span>
                        
                        <%= form_with url: brainstorm_update_group_idea_path(@brainstorm, idea), method: :patch, local: true, class: "inline-block" do |f| %>
                          <%= f.select :group_id, 
                            options_for_select(
                              [["グループなし", ""]] + @brainstorm.groups.where.not(name: nil).where.not(name: "").order(:position).map { |g| [g.name, g.id] }
                            ),
                            {},
                            class: "text-sm border rounded px-2 py-1",
                            onchange: "this.form.submit();" %>
                        <% end %>
                        
                        <%= link_to "編集", edit_brainstorm_idea_path(@brainstorm, idea), class: "text-indigo-600 hover:text-indigo-800 text-sm" %>
                        <%= button_to "削除", brainstorm_idea_path(@brainstorm, idea), method: :delete, data: { turbo_confirm: "削除しますか？" }, class: "text-red-600 hover:text-red-800 text-sm" %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- グループがない場合は通常表示 -->
        <div class="space-y-4">
          <% @brainstorm.ideas.where.not(id: nil).each do |idea| %>
            <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition">
              <div class="flex justify-between items-start">
                <div class="flex-grow">
                  <p class="text-gray-800"><%= idea.content %></p>
                  <% if idea.memo.present? %>
                    <p class="text-sm text-gray-500 mt-2"><%= idea.memo %></p>
                  <% end %>
                </div>
                <div class="flex items-center space-x-2">
                  <span class="px-2 py-1 text-xs rounded <%= idea.source == 'ai' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
                    <%= idea.source == 'ai' ? 'AI生成' : '手動追加' %>
                  </span>
                  <%= link_to "編集", edit_brainstorm_idea_path(@brainstorm, idea), class: "text-indigo-600 hover:text-indigo-800 text-sm" %>
                  <%= button_to "削除", brainstorm_idea_path(@brainstorm, idea), method: :delete, data: { turbo_confirm: "削除しますか？" }, class: "text-red-600 hover:text-red-800 text-sm" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-12 bg-gray-50 rounded-lg">
        <p class="text-gray-600 mb-4">まだアイデアがありません</p>
        <p class="text-gray-500 text-sm mb-6">AIにアイデアを生成させるか、手動でアイデアを追加してください</p>
        <div class="space-x-4">
          <%= form_with url: generate_brainstorm_ideas_path(@brainstorm), method: :post, class: "inline-block", id: "generate-form-bottom", data: { turbo: false } do |f| %>
            <button type="submit"
                class="px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition cursor-pointer"
                onclick="showLoading('AIがアイデアを生成中です...')">
              AIでアイデア生成
            </button>
          <% end %>
          
          <button onclick="document.getElementById('add-idea-form').classList.remove('hidden')" class="px-6 py-3 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition">
            手動で追加
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <!-- 戻るボタン -->
  <div class="mt-6">
    <%= link_to "← ダッシュボードに戻る", dashboard_path, class: "text-indigo-600 hover:text-indigo-800" %>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const sortableContainers = document.querySelectorAll('.sortable-ideas');
      
      sortableContainers.forEach(function(container) {
        new Sortable(container, {
          group: 'ideas',
          animation: 150,
          ghostClass: 'opacity-50',
          draggable: '.idea-card',
          onEnd: function(evt) {
            const ideaId = evt.item.dataset.ideaId;
            const newGroupId = evt.to.dataset.groupId;
            const brainstormId = evt.to.dataset.brainstormId;
            
            console.log('Idea ID:', ideaId, 'New Group:', newGroupId, 'Brainstorm:', brainstormId);
            
            // URLを文字列連結で構築
            const url = '/brainstorms/' + brainstormId + '/ideas/' + ideaId + '/update_group';
            
            // サーバーに更新を送信
            fetch(url, {
              method: 'PATCH',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
              },
              body: JSON.stringify({ group_id: newGroupId })
            })
            .then(response => {
              if (response.ok) {
                // 204の場合はJSONパースをスキップ
                console.log('アイデアを移動しました');
                // プルダウンの選択肢を更新
                const selectElement = evt.item.querySelector('select');
                if (selectElement) {
                  selectElement.value = newGroupId || '';
                }
              }
            })
            .catch(error => console.error('Error:', error));
          }
        });
      });
    });
  </script>
</div>