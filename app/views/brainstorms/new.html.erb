<%# app/views/brainstorms/new.html.erb %>

<div style="background-color: #F7FFFE; min-height: calc(100vh - 120px); padding: 48px 16px;">
  <div style="max-width: 600px; margin: 0 auto;">

    <%# ─── ページヘッダー ─── %>
    <div style="margin-bottom: 28px;">
      <%= link_to dashboard_path,
            style: "display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #4A6972; text-decoration: none; margin-bottom: 18px;" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        ダッシュボードに戻る
      <% end %>
      <h1 style="font-size: 24px; font-weight: 700; color: #0F2027; margin: 0;">
        ✦ 新規ブレスト作成
      </h1>
    </div>

    <%# ─── フォームカード ─── %>
    <div class="ts-section-card">
      <%= form_with(model: @brainstorm, local: true) do |f| %>

        <%# エラー表示 %>
        <% if @brainstorm.errors.any? %>
          <div style="background: #FFF0F0; border: 1.5px solid #FFBDBD; border-radius: 10px; padding: 14px 16px; margin-bottom: 20px; font-size: 13px; color: #C0392B;">
            <p style="font-weight: 700; margin: 0 0 6px;">入力内容を確認してください：</p>
            <ul style="margin: 0; padding-left: 18px;">
              <% @brainstorm.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%# タイトル %>
        <div style="margin-bottom: 20px;">
          <%= f.label :title, "タイトル",
                style: "display: block; font-size: 13px; font-weight: 700; color: #0F2027; margin-bottom: 7px;" %>
          <%= f.text_field :title,
                placeholder: "例：新サービスのアイデア出し",
                autofocus: true,
                style: "width: 100%; border: 1.5px solid #C8EFEB; border-radius: 10px; padding: 10px 14px; font-size: 14px; color: #0F2027; background: #FFFFFF; outline: none; font-family: inherit; box-sizing: border-box; transition: border-color 0.2s;",
                onfocus: "this.style.borderColor='#0ABFA3'",
                onblur: "this.style.borderColor='#C8EFEB'" %>
        </div>

        <%# 説明 %>
        <div style="margin-bottom: 24px;">
          <%= f.label :description, "説明・課題（任意）",
                style: "display: block; font-size: 13px; font-weight: 700; color: #0F2027; margin-bottom: 7px;" %>
          <%= f.text_area :description,
                rows: 5,
                placeholder: "例：20代向けの健康管理サービスのアイデアを考えたい",
                style: "width: 100%; border: 1.5px solid #C8EFEB; border-radius: 10px; padding: 10px 14px; font-size: 14px; color: #0F2027; background: #FFFFFF; outline: none; font-family: inherit; box-sizing: border-box; resize: vertical; transition: border-color 0.2s;",
                onfocus: "this.style.borderColor='#0ABFA3'",
                onblur: "this.style.borderColor='#C8EFEB'" %>
          <p style="font-size: 12px; color: #9BB5BC; margin: 6px 0 0;">後でAIにアイデアを生成させる際の参考になります</p>
        </div>

        <%# ボタン %>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <%= link_to "キャンセル", dashboard_path,
                class: "ts-btn ts-btn-ghost" %>
          <%= f.submit "作成する",
                class: "ts-btn ts-btn-purple cursor-pointer" %>
        </div>

      <% end %>
    </div>

  </div>
</div>
