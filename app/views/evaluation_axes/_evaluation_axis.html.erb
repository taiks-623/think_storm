<div class="ts-axis-item" id="evaluation_axis_<%= evaluation_axis.id %>">
  <span><%= evaluation_axis.name %></span>
  <% if brainstorm.owner?(current_user) || brainstorm.editor?(current_user) %>
    <%= button_to "削除",
          "/brainstorms/#{brainstorm.id}/evaluation_axes/#{evaluation_axis.id}",
          method: :delete,
          data: { turbo_confirm: "評価軸「#{evaluation_axis.name}」を削除しますか？" },
          class: "ts-btn ts-btn-danger ts-btn-xs" %>
  <% end %>
</div>
