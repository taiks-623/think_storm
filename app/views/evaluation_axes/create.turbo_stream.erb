<%= turbo_stream.append "evaluation_axes" do %>
  <%= render "evaluation_axes/evaluation_axis", evaluation_axis: @evaluation_axis, brainstorm: @brainstorm %>
<% end %>

<%= turbo_stream.replace "evaluation_axis_form" do %>
  <%= render "evaluation_axes/form", brainstorm: @brainstorm, evaluation_axis: EvaluationAxis.new %>
<% end %>

<% @brainstorm.ideas.includes(:evaluations, :tags, :groups).each do |idea| %>
  <%= turbo_stream.replace "idea-card-#{idea.id}" do %>
    <%= render "ideas/idea_card", idea: idea, brainstorm: @brainstorm, current_group: idea.groups.first, current_user_id: current_user.id, is_editor: @brainstorm.editor?(current_user) %>
  <% end %>
<% end %>

<%= turbo_stream.replace "chart-reinit-flag" do %>
  <span id="chart-reinit-flag" data-reinit="true"></span>
<% end %>

<%= turbo_stream.replace "evaluation-panel" do %>
  <%= render "brainstorms/evaluation_panel", brainstorm: @brainstorm %>
<% end %>