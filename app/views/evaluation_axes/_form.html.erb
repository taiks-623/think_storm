<%# app/views/evaluation_axes/_form.html.erb %>
<%# locals: brainstorm, evaluation_axis %>

<% if brainstorm.owner?(current_user) || brainstorm.editor?(current_user) %>
  <%= form_with url: brainstorm_evaluation_axes_path(brainstorm),
        method: :post,
        html: { class: "ts-axis-form" } do |f| %>
    <%= f.text_field :name,
          class: "ts-axis-input",
          placeholder: "例：実現可能性、収益性、独自性",
          maxlength: 30 %>
    <%= f.submit "追加",
          class: "ts-btn ts-btn-mint ts-btn-sm cursor-pointer",
          style: "flex-shrink:0;" %>
  <% end %>
<% end %>
