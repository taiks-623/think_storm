<%# app/views/ideas/edit.html.erb %>

<div style="max-width: 680px; margin: 0 auto; padding: 40px 24px 80px;">

  <h1 style="font-family: 'Syne', sans-serif; font-size: 26px; font-weight: 800; color: #0F2027; margin-bottom: 28px;">
    アイデアを編集
  </h1>

  <%# ─── アイデア編集フォーム ─── %>
  <div class="ts-section-card" style="margin-bottom: 20px;">
    <%= form_with(model: [@brainstorm, @idea], local: true) do |f| %>

      <% if @idea.errors.any? %>
        <div style="background: #FEF2F2; border: 1px solid #FCA5A5; color: #EF4444; padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 14px;">
          <p style="font-weight: 700; margin-bottom: 6px;"><%= @idea.errors.count %>件のエラーがあります</p>
          <ul style="list-style: disc; padding-left: 20px;">
            <% @idea.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div style="margin-bottom: 20px;">
        <%= f.label :content, "アイデア内容", class: "ts-form-label" %>
        <%= f.text_area :content, rows: 5, class: "ts-form-textarea", autofocus: true %>
      </div>

      <div style="margin-bottom: 24px;">
        <%= f.label :memo, "メモ（任意）", class: "ts-form-label" %>
        <%= f.text_area :memo, rows: 3, class: "ts-form-textarea",
              placeholder: "補足情報や詳細メモなど" %>
      </div>

      <div class="flex justify-between items-center">
        <%= link_to "キャンセル", brainstorm_path(@brainstorm),
              class: "ts-btn ts-btn-ghost" %>
        <%= f.submit "更新する",
              class: "ts-btn ts-btn-mint cursor-pointer" %>
      </div>

    <% end %>
  </div>

  <%# ─── タグ管理（フォーム外） ─── %>
  <div class="ts-section-card">
    <h2 class="ts-section-heading" style="margin-bottom: 14px;">🏷 タグ</h2>

    <%# 既存タグ %>
    <div class="flex flex-wrap gap-2 mb-4">
      <% @idea.tags.each do |tag| %>
        <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px;
                     background: #D6F5F0; color: #0ABFA3; border-radius: 100px; font-size: 13px; font-weight: 600;">
          #<%= tag.name %>
          <%= button_to "×",
                brainstorm_idea_tag_path(@brainstorm, @idea, tag),
                method: :delete,
                data: { turbo_confirm: "タグ「#{tag.name}」を削除しますか？" },
                style: "background: none; border: none; color: #0ABFA3; font-weight: 700; cursor: pointer; padding: 0; line-height: 1; font-size: 14px;",
                class: "hover:text-red-500" %>
        </span>
      <% end %>
      <% if @idea.tags.empty? %>
        <span style="font-size: 13px; color: #9BB5BC;">タグがありません</span>
      <% end %>
    </div>

    <%# タグ追加フォーム %>
    <%= form_with url: brainstorm_idea_tags_path(@brainstorm, @idea),
          method: :post,
          local: true,
          class: "flex gap-2" do |f| %>
      <%= f.text_field :name,
            name: "tag[name]",
            placeholder: "タグを追加...",
            class: "ts-axis-input",
            style: "flex: 1;" %>
      <%= f.submit "追加",
            class: "ts-btn ts-btn-mint ts-btn-sm cursor-pointer",
            style: "flex-shrink: 0;" %>
    <% end %>
  </div>

  <%= link_to "← ブレストに戻る", brainstorm_path(@brainstorm), class: "ts-back-link" %>

</div>
