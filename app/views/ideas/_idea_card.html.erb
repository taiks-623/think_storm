<%# app/views/ideas/_idea_card.html.erb %>

<div class="ts-idea-card idea-card"
     id="idea-card-<%= idea.id %>"
     data-idea-id="<%= idea.id %>">

  <%# ─── 上部：本文エリア ─── %>
  <div class="ts-idea-top">

    <%# メタ行：バッジ左 / いいね・コメント右 %>
    <div class="ts-idea-meta-row">
      <div class="ts-idea-meta-left">
        <span class="ts-source-badge <%= idea.source == 'ai' ? 'ts-source-ai' : 'ts-source-user' %>">
          <%= idea.source == 'ai' ? '✦ AI生成' : '✎ 手動追加' %>
        </span>
        <% if idea.tags.any? %>
          <% idea.tags.each do |tag| %>
            <span class="ts-tag-chip">#<%= tag.name %></span>
          <% end %>
        <% end %>
      </div>
      <div class="ts-idea-meta-right">
        <%# 投票（turbo_stream） %>
        <div id="vote-<%= idea.id %>">
          <% voted = idea.votes.any? { |v| v.user_id == current_user.id } %>
          <% if voted %>
            <%= button_to "👍 #{idea.votes.size}",
                  brainstorm_idea_vote_path(brainstorm, idea),
                  method: :delete,
                  data: { turbo_stream: true },
                  class: "ts-vote-btn ts-vote-btn-active cursor-pointer" %>
          <% else %>
            <%= button_to "👍 #{idea.votes.size}",
                  brainstorm_idea_vote_path(brainstorm, idea),
                  method: :post,
                  data: { turbo_stream: true },
                  class: "ts-vote-btn cursor-pointer" %>
          <% end %>
        </div>
        <%# コメントトグル %>
        <button onclick="document.getElementById('comments-<%= idea.id %>').classList.toggle('hidden')"
                class="ts-comment-toggle">
          💬（<%= idea.comments.size %>）
        </button>
      </div>
    </div>

    <%# アイデア本文 %>
    <p class="ts-idea-content"><%= idea.content %></p>

    <%# メモ %>
    <% if idea.memo.present? %>
      <p class="ts-idea-memo">📝 <%= idea.memo %></p>
    <% end %>

  </div>

  <%# ─── 下部：評価スコア左 + グループ・操作右 ─── %>
  <% show_bottom = brainstorm.evaluation_axes.any? || brainstorm.groups.any? || brainstorm.editor?(current_user) %>
  <% if show_bottom %>
    <div class="ts-idea-bottom">

      <%# 評価スコア %>
      <% if brainstorm.evaluation_axes.any? %>
        <div class="ts-idea-scores" id="evaluations-idea-<%= idea.id %>">
          <% brainstorm.evaluation_axes.order(:created_at).each do |axis| %>
            <% evaluation = idea.evaluations.find { |e| e.evaluation_axis_id == axis.id } %>
            <div class="ts-score-row">
              <span class="ts-score-label"><%= axis.name %></span>
              <div class="flex gap-1">
                <% (1..5).each do |score| %>
                  <%= form_with url: evaluation ? brainstorm_idea_evaluation_path(brainstorm, idea, evaluation) : brainstorm_idea_evaluations_path(brainstorm, idea),
                        method: evaluation ? :patch : :post,
                        data: { turbo_stream: true } do |f| %>
                    <%= f.hidden_field :evaluation_axis_id, value: axis.id %>
                    <%= f.hidden_field :score, value: score %>
                    <%= f.button type: :submit,
                          class: "ts-score-btn cursor-pointer #{evaluation&.score == score ? 'ts-score-btn-active' : ''}" do %>
                      <%= score %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# グループ選択 + 操作ボタン %>
      <div class="ts-idea-actions-col">
        <% if brainstorm.groups.any? %>
          <%= form_with url: brainstorm_update_group_idea_path(brainstorm, idea),
                method: :patch,
                local: true,
                class: "w-full" do |f| %>
            <%= f.select :group_id,
                  options_for_select(
                    [["グループなし", ""]] + brainstorm.groups.where.not(name: [nil, ""]).order(:position).map { |g| [g.name, g.id] },
                    defined?(current_group) ? current_group&.id : nil
                  ),
                  {},
                  class: "ts-idea-group-select",
                  onchange: "this.form.submit();" %>
          <% end %>
        <% end %>
        <div class="ts-idea-actions-btns">
          <%= link_to "💬 深掘り",
                brainstorm_idea_conversation_path(brainstorm, idea),
                class: "ts-btn ts-btn-ghost ts-btn-xs",
                data: { turbo_frame: "modal" } %>
          <% if brainstorm.editor?(current_user) %>
            <%= link_to "編集",
                  edit_brainstorm_idea_path(brainstorm, idea),
                  class: "ts-btn ts-btn-ghost ts-btn-xs" %>
            <%= button_to "削除",
                  brainstorm_idea_path(brainstorm, idea),
                  method: :delete,
                  data: { turbo_confirm: "削除しますか？" },
                  class: "ts-btn ts-btn-danger ts-btn-xs" %>
          <% end %>
        </div>
      </div>

    </div>
  <% end %>

  <%# ─── コメントセクション（折りたたみ） ─── %>
  <div id="comments-<%= idea.id %>" class="hidden ts-comment-area">
    <div id="comment-list-<%= idea.id %>" class="space-y-2 mb-3">
      <% idea.comments.includes(:user).order(:created_at).each do |comment| %>
        <%= render "comments/comment", comment: comment, brainstorm: brainstorm, idea: idea %>
      <% end %>
    </div>
    <%= form_with url: brainstorm_idea_comments_path(brainstorm, idea),
          data: { turbo_stream: true },
          class: "flex gap-2" do |f| %>
      <%= f.text_field :content,
            placeholder: "コメントを入力...",
            class: "ts-axis-input",
            style: "flex: 1; padding: 7px 12px; font-size: 13px;" %>
      <%= f.submit "送信",
            class: "ts-btn ts-btn-mint ts-btn-xs cursor-pointer",
            style: "flex-shrink: 0;" %>
    <% end %>
  </div>

</div>
