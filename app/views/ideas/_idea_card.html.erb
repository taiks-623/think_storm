<div class="bg-white border border-gray-200 rounded p-3 idea-card" 
     id="idea-card-<%= idea.id %>"
     data-idea-id="<%= idea.id %>">
  <div class="flex justify-between items-start">
    <div class="flex-grow">
      <p class="text-gray-800"><%= idea.content %></p>
      <% if idea.memo.present? %>
        <p class="text-sm text-gray-500 mt-1"><%= idea.memo %></p>
      <% end %>
      <% if idea.tags.any? %>
        <div class="flex flex-wrap gap-1 mt-2">
          <% idea.tags.each do |tag| %>
            <span class="px-2 py-0.5 bg-indigo-100 text-indigo-700 rounded-full text-xs">
              <%= tag.name %>
            </span>
          <% end %>
        </div>
      <% end %>

      <%# 評価軸スコア %>
      <% if brainstorm.evaluation_axes.any? %>
        <div class="mt-3 space-y-1" id="evaluations-idea-<%= idea.id %>">
          <% brainstorm.evaluation_axes.order(:created_at).each do |axis| %>
            <% evaluation = idea.evaluations.find { |e| e.evaluation_axis_id == axis.id } %>
            <div class="flex items-center space-x-2">
              <span class="text-xs text-gray-500 w-24 truncate"><%= axis.name %></span>
              <div class="flex space-x-1">
                <% (1..5).each do |score| %>
                  <%= form_with url: evaluation ? brainstorm_idea_evaluation_path(brainstorm, idea, evaluation) : brainstorm_idea_evaluations_path(brainstorm, idea),
                        method: evaluation ? :patch : :post,
                        data: { turbo_stream: true } do |f| %>
                    <%= f.hidden_field :evaluation_axis_id, value: axis.id %>
                    <%= f.hidden_field :score, value: score %>
                    <%= f.button type: :submit,
                          class: "w-6 h-6 rounded text-xs font-medium transition cursor-pointer #{evaluation&.score == score ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-500 hover:bg-indigo-100'}" do %>
                      <%= score %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="flex items-center space-x-2 ml-4">
      <span class="px-2 py-1 text-xs rounded <%= idea.source == 'ai' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
        <%= idea.source == 'ai' ? 'AI生成' : '手動追加' %>
      </span>

      <% if defined?(brainstorm) && brainstorm.groups.any? %>
        <%= form_with url: brainstorm_update_group_idea_path(brainstorm, idea), method: :patch, local: true, class: "inline-block" do |f| %>
          <%= f.select :group_id,
            options_for_select(
              [["グループなし", ""]] + brainstorm.groups.where.not(name: [nil, ""]).order(:position).map { |g| [g.name, g.id] },
              defined?(current_group) ? current_group&.id : nil
            ),
            {},
            class: "text-sm border rounded px-2 py-1",
            onchange: "this.form.submit();" %>
        <% end %>
      <% end %>

      <%= link_to "💬 深掘り",
            brainstorm_idea_conversation_path(brainstorm, idea),
            class: "px-2 py-1 bg-indigo-50 text-indigo-600 rounded text-sm hover:bg-indigo-100 transition",
            data: { turbo_frame: "modal" } %>

      <%= link_to "編集", edit_brainstorm_idea_path(brainstorm, idea), class: "text-indigo-600 hover:text-indigo-800 text-sm" %>
      <%= button_to "削除", brainstorm_idea_path(brainstorm, idea), method: :delete, data: { turbo_confirm: "削除しますか？" }, class: "text-red-600 hover:text-red-800 text-sm" %>
    </div>
  </div>
  <%# 投票・コメントセクション %>
  <div class="mt-3 pt-3 border-t border-gray-100">
    <div class="flex items-center gap-4">
      <%# 投票ボタン %>
      <div id="vote-<%= idea.id %>">
        <% voted = idea.votes.any? { |v| v.user_id == current_user.id } %>
        <% if voted %>
          <%= button_to "👍 #{idea.votes.size}",
                brainstorm_idea_vote_path(brainstorm, idea),
                method: :delete,
                data: { turbo_stream: true },
                class: "px-3 py-1 bg-indigo-100 text-indigo-700 rounded text-sm cursor-pointer hover:bg-indigo-200 transition" %>
        <% else %>
          <%= button_to "👍 #{idea.votes.size}",
                brainstorm_idea_vote_path(brainstorm, idea),
                method: :post,
                data: { turbo_stream: true },
                class: "px-3 py-1 bg-gray-100 text-gray-600 rounded text-sm cursor-pointer hover:bg-gray-200 transition" %>
        <% end %>
      </div>

      <%# コメント表示トグル %>
      <button onclick="document.getElementById('comments-<%= idea.id %>').classList.toggle('hidden')"
              class="text-sm text-gray-500 hover:text-gray-700">
        💬 コメント（<%= idea.comments.size %>）
      </button>
    </div>

    <%# コメントセクション %>
    <div id="comments-<%= idea.id %>" class="hidden mt-3">
      <%# コメント一覧 %>
      <div id="comment-list-<%= idea.id %>" class="space-y-2 mb-3">
        <% idea.comments.includes(:user).order(:created_at).each do |comment| %>
          <%= render "comments/comment", comment: comment, brainstorm: brainstorm, idea: idea %>
        <% end %>
      </div>

      <%# コメント投稿フォーム %>
      <%= form_with url: brainstorm_idea_comments_path(brainstorm, idea),
            data: { turbo_stream: true },
            class: "flex gap-2" do |f| %>
        <%= f.text_field :content,
              placeholder: "コメントを入力...",
              class: "flex-1 px-3 py-1 border border-gray-300 rounded text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        <%= f.submit "送信",
              class: "px-3 py-1 bg-indigo-600 text-white rounded text-sm cursor-pointer hover:bg-indigo-700 transition" %>
      <% end %>
    </div>
  </div>
</div>