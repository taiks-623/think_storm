<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-8">アカウント設定</h1>

  <%# プロフィール編集 %>
  <section class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-800 mb-4">プロフィール</h2>
    <%= form_with model: current_user, url: users_profile_path, method: :patch do |f| %>
      <% if current_user.errors.any? %>
        <div class="mb-4 p-3 bg-red-50 text-red-700 rounded">
          <% current_user.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>
      <div class="mb-4">
        <%= f.label :name, "表示名", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "名前を入力してください" %>
        <p class="mt-1 text-sm text-gray-500">未設定の場合はメールアドレスが表示されます</p>
      </div>
      <div class="mb-4">
        <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <p class="text-gray-800"><%= current_user.email %></p>
        <% if current_user.unconfirmed_email.present? %>
          <p class="mt-1 text-sm text-yellow-600">確認待ち: <%= current_user.unconfirmed_email %></p>
        <% end %>
      </div>
      <%= f.submit "保存する", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 cursor-pointer" %>
    <% end %>
  </section>

  <%# メアド変更（メール認証ユーザーのみ） %>
  <% if current_user.provider.blank? %>
    <section class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">メールアドレスの変更</h2>
      <%= form_with model: current_user, url: users_email_path, method: :patch do |f| %>
        <div class="mb-4">
          <%= f.label :email, "新しいメールアドレス", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
        <div class="mb-4">
          <%= f.label :current_password, "現在のパスワード（確認用）", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
        <%= f.submit "変更する", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 cursor-pointer" %>
      <% end %>
    </section>

    <%# PW変更（メール認証ユーザーのみ） %>
    <% if current_user.provider.blank? %>
      <section class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">パスワードの変更</h2>
        <%= form_with model: current_user, url: user_registration_path, method: :patch do |f| %>
          <div class="mb-4">
            <%= f.label :current_password, "現在のパスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
          <div class="mb-4">
            <%= f.label :password, "新しいパスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
          <div class="mb-4">
            <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
          <%= f.submit "変更する", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 cursor-pointer" %>
        <% end %>
      </section>
    <% end %>
  <% end %>

  <%# アカウント削除 %>
  <section class="bg-white rounded-lg shadow p-6 border border-red-200">
    <h2 class="text-lg font-semibold text-red-700 mb-2">アカウントの削除</h2>
    <p class="text-sm text-gray-600 mb-4">アカウントを削除すると、すべてのブレストとアイデアが削除されます。この操作は取り消せません。</p>
    <%= button_to "アカウントを削除する", users_account_path, method: :delete,
        data: { turbo_confirm: "本当に削除しますか？この操作は取り消せません。" },
        class: "bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 cursor-pointer" %>
  </section>
</div>