<%# app/views/conversations/show.html.erb %>

<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4"
       style="background: rgba(15,32,39,0.55);"
       id="conversation-modal">
    <div style="background: #FFFFFF; border-radius: 18px; box-shadow: 0 8px 48px rgba(10,191,163,0.13), 0 2px 16px rgba(0,0,0,0.10); width: 100%; max-width: 640px; height: 80vh; display: flex; flex-direction: column; overflow: hidden;">

      <%# ─── ヘッダー ─── %>
      <div style="padding: 18px 22px 16px; border-bottom: 1.5px solid #EEF9F8; display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-shrink: 0;">
        <div style="min-width: 0;">
          <h2 style="font-size: 16px; font-weight: 700; color: #0F2027; margin: 0 0 5px; display: flex; align-items: center; gap: 7px;">
            <span style="display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; background: linear-gradient(135deg, #0ABFA3, #00C8D7); border-radius: 8px; font-size: 13px;">💬</span>
            深掘り対話
          </h2>
          <p style="font-size: 13px; color: #4A6972; margin: 0; line-height: 1.55; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
            <%= @idea.content %>
          </p>
        </div>
        <%= link_to brainstorm_path(@brainstorm),
              style: "flex-shrink: 0; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 8px; color: #9BB5BC; text-decoration: none; font-size: 16px; transition: background 0.15s; background: #F0FAFA;",
              data: { turbo_frame: "_top" } do %>
          ✕
        <% end %>
      </div>

      <%# ─── メッセージ一覧 ─── %>
      <div style="flex: 1; overflow-y: auto; padding: 20px 22px; display: flex; flex-direction: column; gap: 12px;
                  scrollbar-width: thin; scrollbar-color: #C8EFEB transparent;"
           id="messages">
        <% if @messages.empty? %>
          <p style="text-align: center; color: #9BB5BC; font-size: 13px; margin-top: 40px;">
            このアイデアについて何でも聞いてください
          </p>
        <% end %>
        <% @messages.each do |message| %>
          <%= render "conversations/message", message: message %>
        <% end %>
      </div>

      <%# ─── 入力フォーム ─── %>
      <div style="border-top: 1.5px solid #EEF9F8; padding: 14px 18px; flex-shrink: 0; background: #F7FFFE;">
        <div id="conversation-form">
          <%= form_with url: brainstorm_idea_conversation_path(@brainstorm, @idea),
                method: :post,
                id: "chat-form" do |f| %>
            <div style="display: flex; gap: 8px; align-items: flex-end;">
              <%= f.text_area :message,
                    id: "chat-input",
                    rows: 2,
                    placeholder: "質問や深掘りしたい点を入力... (Enterで送信、Shift+Enterで改行)",
                    style: "flex: 1; border: 1.5px solid #C8EFEB; border-radius: 10px; padding: 9px 13px; font-size: 13px; color: #0F2027; background: #FFFFFF; outline: none; resize: none; font-family: inherit; line-height: 1.55; transition: border-color 0.2s;",
                    onfocus: "this.style.borderColor='#0ABFA3'",
                    onblur: "this.style.borderColor='#C8EFEB'" %>
              <%= f.submit "送信",
                    class: "ts-btn ts-btn-purple cursor-pointer",
                    style: "flex-shrink: 0; align-self: flex-end;" %>
            </div>
          <% end %>
        </div>
      </div>

      <script>
        function setupChatInput() {
          const input = document.getElementById("chat-input");
          if (!input || input.dataset.listenerAttached) return;
          input.dataset.listenerAttached = "true";

          input.addEventListener("keydown", function(e) {
            if (e.isComposing || e.keyCode === 229) return;
            if (e.key === "Enter" && !e.shiftKey) {
              e.preventDefault();
              const message = this.value.trim();
              if (message === "") return;
              appendUserMessage(message);
              submitMessage(message);
              this.value = "";
            }
          });
        }

        function submitMessage(message) {
          const form = document.getElementById("chat-form");
          const url = form.action;
          const token = document.querySelector('meta[name="csrf-token"]').content;

          const messages = document.getElementById("messages");
          const loadingDiv = document.createElement("div");
          loadingDiv.id = "loading-message";
          loadingDiv.style.cssText = "display: flex; justify-content: flex-start;";
          loadingDiv.innerHTML = `
            <div style="max-width: 72%; padding: 10px 14px; border-radius: 14px 14px 14px 4px;
                        font-size: 13px; background: #F0FAFA; color: #4A6972; line-height: 1.55;">
              <span style="display: inline-flex; gap: 3px; align-items: center;">
                <span style="animation: ts-dot 1.2s infinite 0s">●</span>
                <span style="animation: ts-dot 1.2s infinite 0.2s">●</span>
                <span style="animation: ts-dot 1.2s infinite 0.4s">●</span>
              </span>
            </div>
          `;
          messages.appendChild(loadingDiv);
          messages.scrollTop = messages.scrollHeight;

          fetch(url, {
            method: "POST",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded",
              "X-CSRF-Token": token,
              "Accept": "text/vnd.turbo-stream.html"
            },
            body: "message=" + encodeURIComponent(message)
          })
          .then(response => response.text())
          .then(html => {
            const loading = document.getElementById("loading-message");
            if (loading) loading.remove();
            Turbo.renderStreamMessage(html);
            setTimeout(setupChatInput, 100);
          })
          .catch(error => {
            const loading = document.getElementById("loading-message");
            if (loading) loading.remove();
            console.error("Error:", error);
          });
        }

        function appendUserMessage(message) {
          const messages = document.getElementById("messages");
          if (!messages) return;
          const div = document.createElement("div");
          div.style.cssText = "display: flex; justify-content: flex-end;";
          div.innerHTML = `<div style="max-width: 72%; padding: 10px 14px; border-radius: 14px 14px 4px 14px;
                                font-size: 13px; background: linear-gradient(135deg, #6C47FF, #8B6FFF);
                                color: white; line-height: 1.55;">
                             <p style="margin: 0;">${message.replace(/</g, "&lt;")}</p>
                           </div>`;
          messages.appendChild(div);
          messages.scrollTop = messages.scrollHeight;
        }

        setupChatInput();
        document.addEventListener("turbo:before-stream-render", function() {
          setTimeout(setupChatInput, 100);
        });
      </script>

      <style>
        @keyframes ts-dot {
          0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
          40%            { opacity: 1;   transform: scale(1); }
        }
        #messages::-webkit-scrollbar { width: 5px; }
        #messages::-webkit-scrollbar-track { background: transparent; }
        #messages::-webkit-scrollbar-thumb { background: #C8EFEB; border-radius: 10px; }
      </style>

    </div>
  </div>
<% end %>
