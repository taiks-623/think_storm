<header class="bg-white shadow">
  <nav class="container mx-auto px-4 py-4 flex justify-between items-center">
    <div class="flex items-center">
      <%= link_to root_path, class: "text-2xl font-bold text-indigo-600" do %>
        ThinkStorm
      <% end %>
    </div>
    
    <div class="flex items-center space-x-4">
      <% if user_signed_in? %>
        <%= link_to "ダッシュボード", "#", class: "text-gray-700 hover:text-indigo-600" %>
        <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" %>
      <% else %>
        <%= link_to "ログイン", new_user_session_path, class: "text-gray-700 hover:text-indigo-600" %>
        <%= link_to "新規登録", new_user_registration_path, class: "px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700" %>
      <% end %>
    </div>
  </nav>
</header>