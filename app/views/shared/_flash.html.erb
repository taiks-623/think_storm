<% flash.each do |type, message| %>
  <div class="fixed top-4 right-4 z-50 max-w-sm"
       data-controller="flash"
       data-flash-target="container">
    <div class="<%= type == 'notice' ? 'bg-green-50 border-green-400 text-green-800' : 'bg-red-50 border-red-400 text-red-800' %> border rounded-lg px-4 py-3 shadow-lg flex items-start gap-3">
      <p class="text-sm"><%= message %></p>
      <button data-action="flash#dismiss" class="ml-auto text-lg leading-none opacity-60 hover:opacity-100">&times;</button>
    </div>
  </div>
<% end %>